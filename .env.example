ANTHROPIC_API_KEY=your_anthropic_api_key
HELPSCOUT_APP_ID=your_app_id
HELPSCOUT_APP_SECRET=your_app_secret

# Same secret you enter when creating the webhook in Help Scout (Manage → Apps → Webhooks).
HELPSCOUT_WEBHOOK_SECRET=your_webhook_secret

# Optional: bind address/port for scripts/triage_webhook_server.py
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8765
